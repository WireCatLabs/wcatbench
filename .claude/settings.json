{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || echo .)}\" && ./scripts/stop-gate.sh",
            "timeout": 180,
            "statusMessage": "wcatbench gate: task gate"
          }
        ]
      }
    ]
  }
}
